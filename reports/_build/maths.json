{"objective": "$\\min_{\\theta\\in\\mathbb{R}^{p}}\\,F(\\theta)=\\frac{1}{N}\\sum_{i=1}^{N}\\ell_i(\\theta),\\qquad \\ell_i(\\theta)=-\\log\\frac{\\exp(z_{i,y_i})}{\\sum_{c=1}^{10}\\exp(z_{i,c})}$", "gradient": "$g_t=\\frac{1}{|B_t|}\\sum_{i\\in B_t}\\nabla_\\theta\\ell_i(\\theta_t)$", "sgd": "$\\theta_{t+1}=\\theta_t-\\eta g_t$", "momentum": "$b_t=\\mu b_{t-1}+g_t,\\qquad \\theta_{t+1}=\\theta_t-\\eta b_t,\\quad b_{-1}=0$", "adam1": "$m_t=\\beta_1m_{t-1}+(1-\\beta_1)g_t,\\qquad v_t=\\beta_2v_{t-1}+(1-\\beta_2)g_t^2$", "adam2": "$\\widehat m_t=\\frac{m_t}{1-\\beta_1^{t+1}},\\quad \\widehat v_t=\\frac{v_t}{1-\\beta_2^{t+1}},\\quad \\theta_{t+1}=\\theta_t-\\eta\\frac{\\widehat m_t}{\\sqrt{\\widehat v_t}+\\epsilon}$"}