{
  "general": "$\\min_{x\\in\\mathbb{R}^{d}} f(x),\\qquad g_k=\\nabla f(x_k)$",
  "rosen": "$f_R(x)=\\sum_{i=1}^{d-1}\\left[100(x_{i+1}-x_i^2)^2+(1-x_i)^2\\right],\\quad f_R^\\star=0$",
  "rosen_hess": "$\\nabla^2 f_R(0,1)=\\mathrm{diag}(-398,\\,200),\\qquad \\nabla f_R(0,1)=(-2,\\,200)^\\top$",
  "rastr": "$f_A(x)=10d+\\sum_{i=1}^{d}\\left[x_i^2-10\\cos(2\\pi x_i)\\right],\\quad f_A^\\star=0$",
  "rastr_der": "$[\\nabla f_A(x)]_i=2x_i+20\\pi\\sin(2\\pi x_i),\\quad [\\nabla^2 f_A(x)]_{ii}=2+40\\pi^2\\cos(2\\pi x_i)$",
  "gd": "$p_k=-g_k,\\qquad x_{k+1}=x_k+\\alpha_k p_k$",
  "armijo": "$f(x_k-\\alpha_k g_k)\\leq f(x_k)-c_1\\alpha_k\\|g_k\\|_2^2$",
  "gd_lower": "$\\alpha_k\\geq\\min\\left\\{1,\\frac{2\\tau(1-c_1)}{L}\\right\\}>0,\\qquad \\sum_{k=0}^{\\infty}\\|g_k\\|_2^2<\\infty$",
  "cg": "$p_0=-g_0,\\quad \\beta_k^{\\mathrm{PR+}}=\\max\\left\\{0,\\frac{g_k^\\top(g_k-g_{k-1})}{g_{k-1}^\\top g_{k-1}}\\right\\},\\quad p_k=-g_k+\\beta_k^{\\mathrm{PR+}}p_{k-1}$",
  "bfgs_defs": "$p_k=-H_k g_k,\\quad s_k=x_{k+1}-x_k,\\quad y_k=g_{k+1}-g_k,\\quad \\rho_k=(y_k^\\top s_k)^{-1}$",
  "bfgs": "$H_{k+1}=(I-\\rho_k s_k y_k^\\top)H_k(I-\\rho_k y_k s_k^\\top)+\\rho_k s_k s_k^\\top$",
  "wolfe": "$f(x_{k+1})\\leq f(x_k)+c_1\\alpha_k g_k^\\top p_k,\\qquad |g_{k+1}^\\top p_k|\\leq c_2|g_k^\\top p_k|$",
  "curvature": "$s_k^\\top y_k=\\alpha_k(g_{k+1}-g_k)^\\top p_k\\geq\\alpha_k(1-c_2)(-g_k^\\top p_k)>0$"
}